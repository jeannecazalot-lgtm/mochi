{
  "expo": {
    "name": "mochi",
    "slug": "mochi",
    "version": "1.0.0",
    "scheme": "mochi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.langora.mochi",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "mochi utilise ta photothèque pour choisir ta photo de profil, visible par ton binôme.",
        "NSUserNotificationsUsageDescription": "mochi t'envoie un rappel à l'heure que tu choisis pour tes tâches du jour.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.langora.mochi",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E97A6A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "mochi utilise ta photothèque pour choisir ta photo de profil, visible par ton binôme."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "jeannegourmande",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c878ab4-58da-4b7a-a546-ff3046e9bf88"
      }
    }
  }
}
